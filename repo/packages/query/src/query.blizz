# Official Blizzard library: simple query-string handling

fn parse(value) {
    let result = {};
    if (len(trim(value)) == 0) {
        return result;
    }
    for pair in split(value, "&") {
        let parts = split(pair, "=");
        let key = parts[0];
        if (len(parts) > 1) {
            result[key] = parts[1];
        } else {
            result[key] = "";
        }
    }
    return result;
}

fn stringify(values) {
    let result = [];
    for key in keys(values) {
        result = append(result, str(key) + "=" + str(values[key]));
    }
    return join(result, "&");
}

fn get(values, key, fallback) {
    if (has(values, key)) {
        return values[key];
    }
    return fallback;
}
