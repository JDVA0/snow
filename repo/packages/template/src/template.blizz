# Official Blizzard library: named placeholder rendering

fn render(source, values) {
    let result = source;
    for key in keys(values) {
        result = replace(result, "{{" + str(key) + "}}", str(values[key]));
    }
    return result;
}

fn has_placeholder(source, key) {
    return contains(source, "{{" + str(key) + "}}");
}

fn missing(source, fields) {
    let result = [];
    for key in fields {
        if (has_placeholder(source, key)) {
            result = append(result, key);
        }
    }
    return result;
}
