# Official Blizzard library: text helpers

fn slug(value) {
    value = lower(trim(value));
    value = replace(value, " ", "-");
    value = replace(value, "!", "");
    value = replace(value, "?", "");
    value = replace(value, ".", "");
    value = replace(value, ",", "");
    return value;
}

fn starts_with(value, prefix) {
    return value[:len(prefix)] == prefix;
}

fn ends_with(value, suffix) {
    return value[len(value) - len(suffix):] == suffix;
}

fn shorten(value, limit) {
    if (len(value) <= limit) {
        return value;
    }
    return value[:limit] + "...";
}
