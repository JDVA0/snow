pub fn unique(values):
    result = []
    for value in values:
        if value not in result:
            result = append(result, value)
    return result

pub fn union(left, right):
    return unique(left + right)

pub fn intersection(left, right):
    result = []
    for value in unique(left):
        if value in right:
            result = append(result, value)
    return result

pub fn difference(left, right):
    result = []
    for value in unique(left):
        if value not in right:
            result = append(result, value)
    return result
