# Official Snow library: dictionary transformations

pub fn pick(source, wanted):
    result = {}
    for key in wanted:
        if has(source, key):
            result[key] = source[key]
    return result

pub fn omit(source, blocked):
    result = {}
    for key in keys(source):
        if not (key in blocked):
            result[key] = source[key]
    return result

pub fn merge(left, right):
    result = {}
    for key in keys(left):
        result[key] = left[key]
    for key in keys(right):
        result[key] = right[key]
    return result

pub fn defaults(source, fallback):
    result = merge(fallback, source)
    return result

pub fn rename(source, old_key, new_key):
    result = merge(source, {})
    if has(result, old_key):
        result[new_key] = result[old_key]
    return result
