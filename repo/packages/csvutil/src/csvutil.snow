# Official Snow library: lightweight CSV helpers for simple rows

pub fn row(line, separator):
    return split(trim(line), separator)

pub fn records(content, separator):
    result = []
    for line in split(trim(content), "\n"):
        if len(trim(line)) > 0:
            result = append(result, row(line, separator))
    return result

pub fn header_map(headers, values):
    result = {}
    for index, key in headers:
        if index < len(values):
            result[key] = values[index]
        else:
            result[key] = nil
    return result

pub fn line(values, separator):
    return join(values, separator)
