# Official Snow library: numeric aggregation and interpolation

pub fn sum(values):
    total = 0
    for value in values:
        total += value
    return total

pub fn median(values):
    if len(values) == 0:
        return nil
    ordered = sort(values)
    middle = len(ordered) // 2
    if len(ordered) % 2 == 1:
        return ordered[middle]
    return (ordered[middle - 1] + ordered[middle]) / 2

pub fn lerp(start, end, amount):
    return start + (end - start) * amount

pub fn percent(part, whole):
    if whole == 0:
        return nil
    return (part / whole) * 100

pub fn in_range(value, low, high):
    return value >= low and value <= high
