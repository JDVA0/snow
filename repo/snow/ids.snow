# Official Snow library: readable identifier helpers

pub fn prefixed(prefix, value):
    return str(prefix) + "_" + str(value)

pub fn zero_pad(value, width):
    result = str(value)
    while len(result) < width:
        result = "0" + result
    return result

pub fn sequence(prefix, value, width):
    return prefixed(prefix, zero_pad(value, width))

pub fn is_prefixed(value, prefix):
    return value[:len(prefix) + 1] == str(prefix) + "_"
