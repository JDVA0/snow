# Official Snow library: practical list transformations

pub fn last(values, fallback):
    if len(values) == 0:
        return fallback
    return values[-1]

pub fn take(values, count):
    if count <= 0:
        return []
    return values[:count]

pub fn drop(values, count):
    if count <= 0:
        return values
    return values[count:]

pub fn chunk(values, size):
    result = []
    if size <= 0:
        return result
    for start in range(0, len(values), size):
        result = append(result, values[start:start + size])
    return result

pub fn count(values, expected):
    total = 0
    for value in values:
        if value == expected:
            total += 1
    return total
