import ./arrays
import ./csvutil
import ./dict
import ./guards
import ./ids
import ./numbers
import ./pagination
import ./query
import ./result
import ./stats
import ./strings
import ./template

assert(arrays.last([1, 2], 0) == 2)
assert(len(arrays.chunk([1, 2, 3], 2)) == 2)
assert(dict.pick({a: 1, b: 2}, ["b"]).b == 2)
assert(strings.kebab_case("Hello Snow") == "hello-snow")
assert(numbers.median([3, 1, 2]) == 2)
assert(query.parse("page=2").page == "2")
assert(csvutil.header_map(["name"], ["Snow"]).name == "Snow")
assert(pagination.metadata(9, 1, 4).pages == 3)
assert(result.is_ok(result.ok("done")))
assert(guards.has_fields({name: "Snow"}, ["name"]))
assert(ids.sequence("user", 7, 3) == "user_007")
assert(template.render("Hello {{name}}", {name: "Snow"}) == "Hello Snow")
assert(stats.summary([1, 2, 3]).mean == 2)
