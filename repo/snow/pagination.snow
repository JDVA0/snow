# Official Snow library: offset pagination helpers

pub fn page(values, number, per_page):
    if number < 1:
        number = 1
    if per_page < 1:
        per_page = 1
    start = (number - 1) * per_page
    return values[start:start + per_page]

pub fn offset(number, per_page):
    if number < 1:
        return 0
    return (number - 1) * per_page

pub fn metadata(total, number, per_page):
    if per_page < 1:
        per_page = 1
    pages = (total + per_page - 1) // per_page
    return {page: number, per_page: per_page, total: total, pages: pages}
