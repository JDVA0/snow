import ../packages.arrays.src.arrays
import ../packages.collections.src.collections
import ../packages.csvutil.src.csvutil
import ../packages.dict.src.dict
import ../packages.guards.src.guards
import ../packages.ids.src.ids
import ../packages.math.src.math
import ../packages.numbers.src.numbers
import ../packages.pagination.src.pagination
import ../packages.query.src.query
import ../packages.result.src.result
import ../packages.stats.src.stats
import ../packages.strings.src.strings
import ../packages.template.src.template
import ../packages.text.src.text
import ../packages.validate.src.validate
import ../packages.sets.src.sets
import ../packages.paths.src.paths

assert(arrays.last([1, 2], 0) == 2)
assert(len(arrays.chunk([1, 2, 3], 2)) == 2)
assert(collections.unique([1, 1, 2]) == [1, 2])
assert(dict.pick({a: 1, b: 2}, ["b"]).b == 2)
assert(strings.kebab_case("Hello Snow") == "hello-snow")
assert(numbers.median([3, 1, 2]) == 2)
assert(query.parse("page=2").page == "2")
assert(csvutil.header_map(["name"], ["Snow"]).name == "Snow")
assert(pagination.metadata(9, 1, 4).pages == 3)
assert(result.is_ok(result.ok("done")))
assert(guards.has_fields({name: "Snow"}, ["name"]))
assert(ids.sequence("user", 7, 3) == "user_007")
assert(math.average([2, 4]) == 3)
assert(template.render("Hello {{name}}", {name: "Snow"}) == "Hello Snow")
assert(stats.summary([1, 2, 3]).mean == 2)
assert(text.slug("Hello, Snow!") == "hello-snow")
assert(validate.email("snow@example.com"))
assert(sets.intersection([1, 2, 2], [2, 3]) == [2])
assert(sets.difference([1, 2, 3], [2]) == [1, 3])
assert(paths.extension("notes.snow") == "snow")
assert(paths.basename("src/main.snow") == "main.snow")
