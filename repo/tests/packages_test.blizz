import blizzard.arrays.src.arrays;
import blizzard.collections.src.collections;
import blizzard.csvutil.src.csvutil;
import blizzard.dict.src.dict;
import blizzard.guards.src.guards;
import blizzard.ids.src.ids;
import blizzard.math.src.math;
import blizzard.numbers.src.numbers;
import blizzard.pagination.src.pagination;
import blizzard.query.src.query;
import blizzard.result.src.result;
import blizzard.stats.src.stats;
import blizzard.strings.src.strings;
import blizzard.template.src.template;
import blizzard.text.src.text;
import blizzard.validate.src.validate;
import blizzard.sets.src.sets;
import blizzard.paths.src.paths;

assert(arrays.last([1, 2], 0) == 2);
assert(len(arrays.chunk([1, 2, 3], 2)) == 2);
assert(collections.unique([1, 1, 2]) == [1, 2]);
assert(dict.pick({a: 1, b: 2}, ["b"]).b == 2);
assert(strings.kebab_case("Hello Blizzard") == "hello-blizzard");
assert(numbers.median([3, 1, 2]) == 2);
assert(query.parse("page=2").page == "2");
assert(csvutil.header_map(["name"], ["Blizzard"]).name == "Blizzard");
assert(pagination.metadata(9, 1, 4).pages == 3);
assert(result.is_ok(result.ok("done")));
assert(guards.has_fields({name: "Blizzard"}, ["name"]));
assert(ids.sequence("user", 7, 3) == "user_007");
assert(math.average([2, 4]) == 3);
assert(template.render("Hello {{name}}", {name: "Blizzard"}) == "Hello Blizzard");
assert(stats.summary([1, 2, 3]).mean == 2);
assert(text.slug("Hello, Blizzard!") == "hello-blizzard");
assert(validate.email("blizzard@example.com"));
assert(sets.intersection([1, 2, 2], [2, 3]) == [2]);
assert(sets.difference([1, 2, 3], [2]) == [1, 3]);
assert(paths.extension("notes.blizz") == "blizz");
assert(paths.basename("src/main.blizz") == "main.blizz");
