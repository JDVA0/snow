# Official Snow library: small numeric helpers

pub fn clamp(value, low, high):
    if value < low:
        return low
    if value > high:
        return high
    return value

pub fn between(value, low, high):
    return value >= low and value <= high

pub fn average(values):
    if len(values) == 0:
        return nil
    total = 0
    for value in values:
        total += value
    return total / len(values)
