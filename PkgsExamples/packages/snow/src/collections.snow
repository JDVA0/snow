# Official Snow library: list helpers

pub fn unique(values):
    result = []
    for value in values:
        if not (value in result):
            result = append(result, value)
    return result

pub fn first_or(values, fallback):
    if len(values) == 0:
        return fallback
    return values[0]

pub fn compact(values):
    result = []
    for value in values:
        if value != nil:
            result = append(result, value)
    return result
