{
  "name": "Snow",
  "scopeName": "source.snow",
  "patterns": [
    {
      "match": "\\b(using|import|pub|priv|const|fn|return|if|elif|else|for|while|break|continue|try|catch|always|match|case|where|with|not|in|and|or|as)\\b",
      "name": "keyword.control.snow"
    },
    {
      "match": "\\b(true|false|nil)\\b",
      "name": "constant.language.snow"
    },
    {
      "match": "\\b(0b[01]+|0o[0-7]+|0x[0-9a-fA-F]+)\\b",
      "name": "constant.numeric.base.snow"
    },
    {
      "match": "\\b\\d+\\.\\d+\\b",
      "name": "constant.numeric.float.snow"
    },
    {
      "match": "\\b\\d+\\b",
      "name": "constant.numeric.integer.snow"
    },
    {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.snow",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.snow"
        }
      ]
    },
    {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.snow",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.snow"
        }
      ]
    },
    {
      "begin": "f\"",
      "end": "\"",
      "name": "string.interpolated.snow",
      "patterns": [
        {
          "match": "\\{[^}]*\\}",
          "name": "variable.interpolation.snow"
        },
        {
          "match": "\\\\.",
          "name": "constant.character.escape.snow"
        }
      ]
    },
    {
      "begin": "f'",
      "end": "'",
      "name": "string.interpolated.snow",
      "patterns": [
        {
          "match": "\\{[^}]*\\}",
          "name": "variable.interpolation.snow"
        },
        {
          "match": "\\\\.",
          "name": "constant.character.escape.snow"
        }
      ]
    },
    {
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "name": "string.quoted.triple.snow"
    },
    {
      "begin": "'''",
      "end": "'''",
      "name": "string.quoted.triple.snow"
    },
    {
      "match": "#.*$",
      "name": "comment.line.snow"
    },
    {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.other.snow"
    },
    {
      "match": "\\.[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.member.snow"
    },
    {
      "match": "\\?[.\\[]",
      "name": "keyword.operator.safe.snow"
    },
    {
      "match": "=>|=>|\\?\\?\\?",
      "name": "keyword.operator.snow"
    },
    {
      "match": "[-+*/%&|^!<>]=?",
      "name": "keyword.operator.snow"
    },
    {
      "match": "[()\\[\\]{}:,;]",
      "name": "punctuation.snow"
    }
  ]
}