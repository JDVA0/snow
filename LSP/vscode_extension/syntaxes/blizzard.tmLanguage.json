{
  "name": "Blizzard",
  "scopeName": "source.blizz",
  "patterns": [
    {
      "match": "\\b(import|let|pub|priv|const|fn|return|if|elif|else|for|while|break|continue|try|catch|always|match|case|where|with|not|in|and|or|as)\\b",
      "name": "keyword.control.blizz"
    },
    {
      "match": "\\b(true|false|nil)\\b",
      "name": "constant.language.blizz"
    },
    {
      "match": "\\b(0b[01]+|0o[0-7]+|0x[0-9a-fA-F]+)\\b",
      "name": "constant.numeric.base.blizz"
    },
    {
      "match": "\\b\\d+\\.\\d+\\b",
      "name": "constant.numeric.float.blizz"
    },
    {
      "match": "\\b\\d+\\b",
      "name": "constant.numeric.integer.blizz"
    },
    {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.blizz",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.blizz"
        }
      ]
    },
    {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.blizz",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.blizz"
        }
      ]
    },
    {
      "begin": "f\"",
      "end": "\"",
      "name": "string.interpolated.blizz",
      "patterns": [
        {
          "match": "\\{[^}]*\\}",
          "name": "variable.interpolation.blizz"
        },
        {
          "match": "\\\\.",
          "name": "constant.character.escape.blizz"
        }
      ]
    },
    {
      "begin": "f'",
      "end": "'",
      "name": "string.interpolated.blizz",
      "patterns": [
        {
          "match": "\\{[^}]*\\}",
          "name": "variable.interpolation.blizz"
        },
        {
          "match": "\\\\.",
          "name": "constant.character.escape.blizz"
        }
      ]
    },
    {
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "name": "string.quoted.triple.blizz"
    },
    {
      "begin": "'''",
      "end": "'''",
      "name": "string.quoted.triple.blizz"
    },
    {
      "match": "#.*$",
      "name": "comment.line.blizz"
    },
    {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.other.blizz"
    },
    {
      "match": "\\.[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.member.blizz"
    },
    {
      "match": "\\?[.\\[]",
      "name": "keyword.operator.safe.blizz"
    },
    {
      "match": "\\.\\.\\.",
      "name": "keyword.operator.spread.blizz"
    },
    {
      "match": "=>|=>|\\?\\?\\?",
      "name": "keyword.operator.blizz"
    },
    {
      "match": "[-+*/%&|^!<>]=?",
      "name": "keyword.operator.blizz"
    },
    {
      "match": "[()\\[\\]{}:,;]",
      "name": "punctuation.blizz"
    }
  ]
}
