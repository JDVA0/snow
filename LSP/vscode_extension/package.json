{
  "name": "blizzard-language",
  "displayName": "Blizzard Language",
  "description": "Blizzard language support with LSP integration, snippets and symbol outline.",
  "version": "0.2.0",
  "publisher": "JDVA0",
  "repository": {
    "type": "git",
    "url": "https://github.com/JDVA0/blizzard"
  },
  "license": "MIT",
  "icon": "./icons/blizzard-icon.png",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "blizzard",
    "blizzard-language",
    "lsp",
    "compiler",
    "scripting"
  ],
  "activationEvents": [
    "onLanguage:blizzard",
    "onStartupFinished",
    "workspaceContains:**/*.blizz"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p . && esbuild out/extension.js --bundle --platform=node --external:vscode --outfile=out/extension.bundle.js && mv out/extension.bundle.js out/extension.js",
    "watch": "tsc -p . -w",
    "audit": "pnpm audit"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.89.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5",
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "blizzard",
        "aliases": [
          "Blizzard",
          "blizzard"
        ],
        "extensions": [
          ".blizz"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "blizzard",
        "scopeName": "source.blizz",
        "path": "./syntaxes/blizzard.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "blizzard-icons",
        "label": "Blizzard Icons",
        "path": "./icons/blizzard-icon-theme.json",
        "default": true
      }
    ],
    "snippets": [
      {
        "language": "blizzard",
        "path": "./snippets/blizzard.json"
      }
    ]
  },
  "configuration": {
    "title": "Blizzard",
    "properties": {
      "blizzard.lsp.path": {
        "type": "string",
        "default": "",
        "description": "Optional path to the Blizzard LSP server. By default, the workspace LSP/blizzard-lsp is used."
      },
      "blizzard.lsp.enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable Blizzard LSP (completion, hover, definitions, outline symbols, diagnostics)."
      },
      "blizzard.editor.autocompleteOnDot": {
        "type": "boolean",
        "default": true,
        "description": "Trigger method/attribute autocomplete when the user types a dot."
      },
      "blizzard.outline.showNestedSymbols": {
        "type": "boolean",
        "default": true,
        "description": "Show nested symbols (for-block vars, function internals) in the outline."
      }
    }
  }
}
