# Módulo string_utils - Segundo ejemplo de pub/priv visibilidad
#
# Uso desde otro archivo:
#   import string_utils as s
#   print(s.to_upper("hola"))      # ok, pub por defecto
#   print(s.slugify("Hola Mundo")) # ok, pub explícito
#   print(s._trim_special("@@x@")) # ERROR: attribute not found (priv)

# ================================
#  SIMBOLOS PÚBLICOS (exportados)
# ================================

pub VERSION = "0.9.0"

# Sin modificador → pub POR DEFECTO
fn to_upper(s):
    return upper(s)

fn to_lower(s):
    return lower(s)

pub fn reverse_text(s):
    return reverse(s)

pub fn slugify(text):
    # Normaliza: minúsculas, reemplaza espacios por -, quita chars especiales
    t = to_lower(text)
    t = replace(t, " ", "-")
    t = _trim_special(t)
    return t

pub fn count_words(s):
    if s == "":
        return 0
    parts = split(trim(s), " ")
    return len(parts)

# ================================
#  SIMBOLOS PRIVADOS (solo aquí)
# ================================

priv _SPECIAL_CHARS = "!@#$%^&*()[]{}<>?/\\|\"'`~"

priv fn _trim_special(s):
    # Helper interno: quita caracteres de _SPECIAL_CHARS
    s = replace(s, "!", "")
    s = replace(s, "@", "")
    return s

priv fn _log(msg):
    using cli
    cli.info("[string_utils] " + msg)

# Dentro del módulo podemos usar los símbolos privados sin problema
_log("Loaded v" + VERSION + ", specials=" + _SPECIAL_CHARS)
