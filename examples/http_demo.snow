# http_demo.snow — HTTP client example
# Demonstrates: using http, resp.json(), f-strings, ?? operator

using http

# Simple GET request
print("--- GET httpbin.org ---")
resp = http.get("https://httpbin.org/get")
if resp.ok:
    data = resp.json()
    print(f"Status: {resp.status}")
    print(f"URL: {data['url']}")
else:
    print(f"Request failed with status {resp.status}")

# POST with a JSON body (dict is auto-encoded)
print("\n--- POST httpbin.org/post ---")
resp2 = http.post("https://httpbin.org/post", {
    name: "Snow",
    version: "0.1",
    cool: true
})
if resp2.ok:
    body = resp2.json()
    print(f"Sent JSON: {body['json']}")

# ?? operator — use a default when a key is missing
print("\n--- Nullish coalescing ?? ---")
user = nil
greeting = f"Hello, {user ?? 'stranger'}!"
print(greeting)

# F-string with expressions
x = 40
y = 2
print(f"The answer is {x + y}")
