using api
using db

const PORT = 8080
const DB_FILE = "tasks.db"

store = db.open(DB_FILE)


# ============================================================
# UTILIDADES
# ============================================================

fn next_id():
    ids = store.keys()

    if len(ids) == 0:
        return 1

    return len(ids) + 1


fn task_key(id):
    return f"task:{id}"


fn get_task(id):
    return store.get(task_key(id))


fn task_exists(id):
    return store.has(task_key(id))


fn save_task(task):
    store.set(task_key(task.id), task)
    store.save()


fn remove_task(id):
    store.delete(task_key(id))
    store.save()


fn validate_task(data):

    if data == nil:
        return "JSON body is required"

    if data?.title == nil:
        return "title is required"

    if data.title == "":
        return "title cannot be empty"

    if data?.priority != nil:
        allowed = ["low", "normal", "high"]

        if data.priority not in allowed:
            return "priority must be low, normal or high"

    return nil


fn make_task(data):

    id = next_id()

    return {
        id: id,
        title: data.title,
        description: data?.description ?? "",
        priority: data?.priority ?? "normal",
        completed: data?.completed ?? false
    }


fn all_tasks():

    tasks = []

    for key, value in store.all():

        if key[:5] == "task:":
            tasks = append(tasks, value)

    return tasks


fn find_tasks(query):

    result = []

    for task in all_tasks() where query in task.title:
        result = append(result, task)

    return result


fn completed_tasks():

    return filter_tasks(true)


fn pending_tasks():

    return filter_tasks(false)


fn filter_tasks(completed):

    result = []

    for task in all_tasks() where task.completed == completed:
        result = append(result, task)

    return result


fn task_stats():

    tasks = all_tasks()

    total = len(tasks)
    completed = len(completed_tasks())
    pending = len(pending_tasks())

    high = 0

    for task in tasks where task.priority == "high":
        high += 1

    return {
        total: total,
        completed: completed,
        pending: pending,
        high_priority: high
    }


# ============================================================
# MIDDLEWARE
# ============================================================

api.cors()


# ============================================================
# HOME
# ============================================================

fn home(req):

    return api.json({
        name: "Snow Task Manager",
        version: "1.0",
        status: "ok",
        endpoints: [
            "GET /tasks",
            "GET /tasks/:id",
            "POST /tasks",
            "PUT /tasks/:id",
            "PATCH /tasks/:id/complete",
            "DELETE /tasks/:id",
            "GET /tasks/search/:query",
            "GET /tasks/stats"
        ]
    })


api.get("/", home)


# ============================================================
# LIST TASKS
# ============================================================

fn list_tasks(req):

    tasks = all_tasks()

    completed = req.query?.completed
    priority = req.query?.priority

    if completed != nil:

        if completed == "true":
            tasks = filter_tasks(true)

        elif completed == "false":
            tasks = filter_tasks(false)


    if priority != nil:

        filtered = []

        for task in tasks where task.priority == priority:
            filtered = append(filtered, task)

        tasks = filtered


    return api.json({
        count: len(tasks),
        tasks: tasks
    })


api.get("/tasks", list_tasks)


# ============================================================
# GET TASK
# ============================================================

fn get_task_handler(req):

    id = req.params.id

    task = get_task(id)

    if task == nil:

        return api.json({
            error: "task not found",
            id: id
        }, 404)

    return api.json(task)


api.get("/tasks/:id", get_task_handler)


# ============================================================
# CREATE TASK
# ============================================================

fn create_task(req):

    try:

        data = req.json

        error = validate_task(data)

        if error != nil:

            return api.json({
                error: error
            }, 400)

        task = make_task(data)

        save_task(task)

        return api.json({
            message: "task created",
            task: task
        }, 201)

    catch err:

        return api.json({
            error: "invalid request",
            detail: err
        }, 400)


api.post("/tasks", create_task)


# ============================================================
# UPDATE TASK
# ============================================================

fn update_task(req):

    id = req.params.id

    current = get_task(id)

    if current == nil:

        return api.json({
            error: "task not found"
        }, 404)


    try:

        data = req.json

        if data?.title != nil:
            current.title = data.title

        if data?.description != nil:
            current.description = data.description

        if data?.priority != nil:

            allowed = ["low", "normal", "high"]

            if data.priority not in allowed:

                return api.json({
                    error: "invalid priority"
                }, 400)

            current.priority = data.priority


        if data?.completed != nil:
            current.completed = data.completed


        save_task(current)

        return api.json({
            message: "task updated",
            task: current
        })

    catch err:

        return api.json({
            error: "invalid request",
            detail: err
        }, 400)


api.put("/tasks/:id", update_task)


# ============================================================
# COMPLETE TASK
# ============================================================

fn complete_task(req):

    id = req.params.id

    task = get_task(id)

    if task == nil:

        return api.json({
            error: "task not found"
        }, 404)


    task.completed = true

    save_task(task)

    return api.json({
        message: "task completed",
        task: task
    })


api.patch("/tasks/:id/complete", complete_task)


# ============================================================
# DELETE TASK
# ============================================================

fn delete_task_handler(req):

    id = req.params.id

    if not task_exists(id):

        return api.json({
            error: "task not found"
        }, 404)


    remove_task(id)

    return api.json({
        message: "task deleted",
        id: id
    })


api.delete("/tasks/:id", delete_task_handler)


# ============================================================
# SEARCH
# ============================================================

fn search_tasks(req):

    query = req.params.query

    results = find_tasks(query)

    return api.json({
        query: query,
        count: len(results),
        tasks: results
    })


api.get("/tasks/search/:query", search_tasks)


# ============================================================
# STATISTICS
# ============================================================

fn stats(req):

    return api.json(task_stats())


api.get("/tasks/stats", stats)


# ============================================================
# HIGH PRIORITY TASKS
# ============================================================

fn high_priority(req):

    tasks = []

    for task in all_tasks() where task.priority == "high":
        tasks = append(tasks, task)

    return api.json({
        count: len(tasks),
        tasks: tasks
    })


api.get("/tasks/high", high_priority)


# ============================================================
# MARK ALL AS COMPLETED
# ============================================================

fn complete_all(req):

    tasks = all_tasks()
    completed = 0

    for task in tasks where task.completed == false:

        task.completed = true

        save_task(task)

        completed += 1


    return api.json({
        message: "tasks completed",
        count: completed
    })


api.patch("/tasks/complete-all", complete_all)


# ============================================================
# DELETE ALL COMPLETED
# ============================================================

fn delete_completed(req):

    tasks = completed_tasks()
    removed = 0

    for task in tasks:

        remove_task(task.id)

        removed += 1


    return api.json({
        message: "completed tasks deleted",
        count: removed
    })


api.delete("/tasks/completed", delete_completed)


# ============================================================
# START
# ============================================================

print("========================================")
print("        Snow Task Manager")
print("========================================")
print("")
print(f"Database: {DB_FILE}")
print(f"Port: {PORT}")
print("")
print("GET    /")
print("GET    /tasks")
print("GET    /tasks/:id")
print("POST   /tasks")
print("PUT    /tasks/:id")
print("PATCH  /tasks/:id/complete")
print("PATCH  /tasks/complete-all")
print("DELETE /tasks/:id")
print("DELETE /tasks/completed")
print("GET    /tasks/search/:query")
print("GET    /tasks/stats")
print("GET    /tasks/high")
print("")

api.serve(PORT)