# Snow CLI Suite — A beautiful, interactive CLI application built in Snow.
#
# Usage:
#   snowman examples/cli_app.snow
#   snowman examples/cli_app.snow sysinfo
#   snowman examples/cli_app.snow files
#   snowman examples/cli_app.snow run "echo 'Snow rocks!'"

using cli
using sys
using fs

parsed = cli.parse()
args = parsed.args
cmd = "menu"
if len(args) > 0:
    cmd = args[0]

# Display beautiful header
cli.box("❄️ SNOW CLI TOOLKIT", "A modern, concise & elegant CLI experience\nPlatform: " + sys.platform + " (" + sys.arch + ") | PID: " + str(sys.pid))

if cmd == "sysinfo":
    cli.info("Gathering system information...")
    uptime_res = sys.sh("uptime -p")
    uptime = "N/A"
    if uptime_res.ok:
        uptime = trim(uptime_res.stdout)

    headers = ["KEY", "VALUE"]
    rows = [
        ["Operating System", sys.platform],
        ["Architecture", sys.arch],
        ["Process PID", str(sys.pid)],
        ["Working Directory", sys.cwd()],
        ["System Uptime", uptime]
    ]
    cli.table(headers, rows)
    cli.success("System info rendered successfully!")

elif cmd == "files":
    cli.info("Listing files in current directory:")
    file_list = fs.list(".")
    headers = ["FILE NAME", "TYPE"]
    rows = []
    for f in file_list:
        ftype = "file"
        if fs.is_dir(f):
            ftype = "directory"
        rows = append(rows, [f, ftype])
    cli.table(headers, rows)
    cli.success("Found " + str(len(file_list)) + " entries.")

elif cmd == "run":
    if len(args) < 2:
        cli.error("Please provide a command to run: snowman examples/cli_app.snow run <cmd>")
        sys.exit(1)
    target = args[1]
    cli.info("Executing: " + cli.yellow(target))
    res = sys.sh(target)
    if res.ok:
        cli.success("Command finished successfully (code 0):")
        print(trim(res.stdout))
    else:
        cli.error("Command failed with code " + str(res.code) + ":")
        print(trim(res.stderr))

else:
    print("")
    cli.info("Available subcommands:")
    print("  " + cli.bold("sysinfo") + "  - View system specifications in a clean table")
    print("  " + cli.bold("files") + "    - List current directory items with types")
    print("  " + cli.bold("run") + "      - Execute a shell command through Snow sys")
    print("")
    cli.info("Try running: snowman examples/cli_app.snow sysinfo")
