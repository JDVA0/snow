# Demo completa de módulos: pub / priv + import (con alias y sin alias)
#
# EJECUCIÓN DESDE LA RAÍZ DEL PROYECTO:
#   ./snowman examples/modules_demo.snow
#
# Qué demuestra:
#   1. import SIN alias   ->  import math_utils
#   2. import CON alias   ->  import string_utils as s
#   3. Acceso a símbolos públicos (funciones y constantes) de AMBOS módulos
#   4. Acceso a símbolos PRIVADOS -> todos fallan con attribute not found (se captura con try/catch)
#   5. Composición: usar funciones de ambos módulos en el mismo código (where + for, pub fn add + pub fn slugify)

import math_utils
import string_utils as s
using cli

cli.box("MODULES + pub/priv DEMO", "Importando con alias y SIN alias\nmath_utils (sin alias) + string_utils as s")

# ============================================================
#  PARTE 1: Símbolos PÚBLICOS (TODOS deben funcionar)
# ============================================================
cli.info("1) Símbolos PÚBLICOS exportados correctamente:")
print("  math_utils.VERSION       = " + math_utils.VERSION)
print("  math_utils.AUTHOR        = " + math_utils.AUTHOR)
print("  math_utils.add(5, 3)     = " + str(math_utils.add(5, 3)))
print("  math_utils.subtract(10,4)= " + str(math_utils.subtract(10, 4)))
print("  math_utils.multiply(6,7) = " + str(math_utils.multiply(6, 7)))
print("  math_utils.divide(20, 4) = " + str(math_utils.divide(20, 4)))
print()
print("  s.VERSION                = " + s.VERSION)
print("  s.to_upper(\"hola\")       = " + s.to_upper("hola"))
print("  s.to_lower(\"MUNDO\")      = " + s.to_lower("MUNDO"))
print("  s.reverse_text(\"abcde\")  = " + s.reverse_text("abcde"))
print("  s.slugify(\"Hola Mundo!\") = " + s.slugify("Hola Mundo!"))
print("  s.count_words(\"uno dos tres\") = " + str(s.count_words("uno dos tres")))
print()

# ============================================================
#  PARTE 2: Símbolos PRIVADOS (TODOS deben FALLAR)
# ============================================================
cli.warn("2) Intentando acceder a símbolos PRIVADOS... (cada uno debe dar 'attribute not found')")

fallos = []

try:
    math_utils._secret_key
    cli.error("  [ERROR] math_utils._secret_key no debía ser accesible")
    append(fallos, "math_utils._secret_key")
catch e:
    cli.ok("  [OK] math_utils._secret_key -> " + str(e))

try:
    math_utils._double(5)
    cli.error("  [ERROR] math_utils._double no debía ser accesible")
    append(fallos, "math_utils._double")
catch e:
    cli.ok("  [OK] math_utils._double -> " + str(e))

try:
    math_utils._log("x")
    cli.error("  [ERROR] math_utils._log no debía ser accesible")
    append(fallos, "math_utils._log")
catch e:
    cli.ok("  [OK] math_utils._log -> " + str(e))
print()

try:
    s._SPECIAL_CHARS
    cli.error("  [ERROR] s._SPECIAL_CHARS no debía ser accesible")
    append(fallos, "s._SPECIAL_CHARS")
catch e:
    cli.ok("  [OK] s._SPECIAL_CHARS -> " + str(e))

try:
    s._trim_special("@@x")
    cli.error("  [ERROR] s._trim_special no debía ser accesible")
    append(fallos, "s._trim_special")
catch e:
    cli.ok("  [OK] s._trim_special -> " + str(e))

try:
    s._log("x")
    cli.error("  [ERROR] s._log no debía ser accesible")
    append(fallos, "s._log")
catch e:
    cli.ok("  [OK] s._log -> " + str(e))
print()

if len(fallos) > 0:
    cli.error("Hubo " + str(len(fallos)) + " símbolos privados accesibles: " + join(fallos, ", "))
    fail("pub/priv leak")
cli.ok("  [OK] Ningún símbolo privado se filtró. Encapsulación correcta.")
print()

# ============================================================
#  PARTE 3: Composición (for + where + pub fn de AMBOS módulos)
# ============================================================
cli.info("3) Composición: for where + slugify + multiply + add")

# Usuarios inventados
usuarios = [
    {nombre: "  Ana García  ", score: 10, activo: true},
    {nombre: "Luis Martín",   score: 5,  activo: false},
    {nombre: "  Pepe Ruiz!!",  score: 8,  activo: true},
    {nombre: "María López",   score: 3,  activo: true}
]

total = 0
for u in usuarios where u.activo:
    slug = s.slugify(u.nombre)
    # Doble de puntos usando multiply SIN ALIAS
    pts = math_utils.multiply(u.score, 2)
    total = math_utils.add(total, pts)
    print("  - " + slug + " -> " + str(u.score) + " x 2 = " + str(pts))

cli.success("Puntuación total activos: " + str(total))
print()

# ============================================================
#  FIN
# ============================================================
cli.success("[OK] Demo completa pub/priv + imports + where + módulos múltiples!")
