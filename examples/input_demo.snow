# Snow Input Module Demo — Interactive terminal prompts in Snow.
#
# Usage:
#   snowman examples/input_demo.snow

using input
using cli

cli.box("REGISTRO DE USUARIO", "Demostración interactiva del módulo 'input' en Snow")

nombre = input.str("Ingrese su nombre [Invitado]: ", "Invitado")
edad = input.int("Ingrese su edad [18]: ", 18)
salario = input.float("Salario esperado [1500.50]: ", 1500.50)
notificaciones = input.bool("Desea recibir notificaciones? (s/n) [s]: ", true)
clave = input.hidden("Ingrese una clave secreta [12345]: ", "12345")

cli.success("Datos capturados correctamente:")

resumen = [
    ["Nombre", nombre],
    ["Edad", str(edad)],
    ["Salario", str(salario)],
    ["Notificaciones", str(notificaciones)],
    ["Clave", "****** (" + str(len(clave)) + " caracteres)"]
]

cli.table(["CAMPO", "VALOR"], resumen)
