# db_demo.snow — Lightweight JSON-backed Key-Value Store
# Demonstrates: using db, store.set, store.get, store.all, store.save, f-strings, ?? operator

using db
using fs

db_file = "test_store.json"

# Clean up previous test file if present
if fs.exists(db_file):
    fs.remove(db_file)

print("--- Opening / Creating DB ---")
store = db.open(db_file)
print(f"Store path: {store.path}")

# Setting key-value entries
print("\n--- Setting values ---")
store.set("app_name", "SnowDB")
store.set("version", "0.2")
store.set("users_count", 150)
store.set("metadata", {
    "author": "Julian",
    "status": "active"
})
print("Keys stored:", store.keys())

# Getting values with default fallback
print("\n--- Getting values ---")
app = store.get("app_name")
missing = store.get("non_existent", "default_value")
print(f"App name: {app}")
print(f"Missing key fallback: {missing}")

# Check key existence
print(f"Has 'app_name'? {store.has('app_name')}")
print(f"Has 'secret'?   {store.has('secret')}")

# Save to disk
print("\n--- Persisting to disk ---")
store.save()
info = fs.stat(db_file)
print(f"File created: {fs.exists(db_file)} (size: {info.size} bytes)")

# Read all data
print("\n--- All DB contents ---")
data = store.all()
print(data)

# Reopen and verify persistence
print("\n--- Reopening DB from disk ---")
reopened = db.open(db_file)
print(f"Reopened app_name: {reopened.get('app_name')}")
print(f"Reopened count:    {reopened.get('users_count')}")

# Delete a key and save
print("\n--- Deleting a key ---")
reopened.delete("users_count")
reopened.save()
print(f"Has 'users_count' after delete? {reopened.has('users_count')}")
print(f"Remaining keys: {reopened.keys()}")

# Clean up
fs.remove(db_file)
print("\n[OK] DB demo completed successfully!")
