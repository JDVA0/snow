# Blizzard CLI Suite — A beautiful, interactive CLI application built in Blizzard.
#
# Usage:
#   blizzard examples/cli_app.blizz
#   blizzard examples/cli_app.blizz sysinfo
#   blizzard examples/cli_app.blizz files
#   blizzard examples/cli_app.blizz run "echo 'Blizzard rocks!'"

import cli;
import sys;
import fs;

let parsed = cli.parse();
let args = parsed.args;
let cmd = "menu";
if (len(args) > 0) {
    cmd = args[0];
}

# Display beautiful header
cli.box("BLIZZARD CLI TOOLKIT", """A modern, concise & elegant CLI experience
Platform: """ + sys.platform + " (" + sys.arch + ") | PID: " + str(sys.pid));

if (cmd == "sysinfo") {
    cli.info("Gathering system information...");
    let uptime_res = sys.sh("uptime -p");
    let uptime = "N/A";
    if (uptime_res.ok) {
        uptime = trim(uptime_res.stdout);
    }

    let headers = ["KEY", "VALUE"];
    let rows = [["Operating System", sys.platform], ["Architecture", sys.arch], ["Process PID", str(sys.pid)], ["Working Directory", sys.cwd()], ["System Uptime", uptime]];
    cli.table(headers, rows);
    cli.success("System info rendered successfully!");
} elif (cmd == "files") {

    cli.info("Listing files in current directory:");
    let file_list = fs.list(".");
    headers = ["FILE NAME", "TYPE"];
    rows = [];
    for f in file_list {
        let ftype = "file";
        if (fs.is_dir(f)) {
            ftype = "directory";
        }
        rows = append(rows, [f, ftype]);
    }
    cli.table(headers, rows);
    cli.success("Found " + str(len(file_list)) + " entries.");
} elif (cmd == "run") {

    if (len(args) < 2) {
        cli.error("Please provide a command to run: blizzard examples/cli_app.blizz run <cmd>");
        sys.exit(1);
    }
    let target = args[1];
    cli.info("Executing: " + cli.yellow(target));
    let res = sys.sh(target);
    if (res.ok) {
        cli.success("Command finished successfully (code 0):");
        print(trim(res.stdout));
    } else {
        cli.error("Command failed with code " + str(res.code) + ":");
        print(trim(res.stderr));
    }
} else {

    print("");
    cli.info("Available subcommands:");
    print("  " + cli.bold("sysinfo") + "  - View system specifications in a clean table");
    print("  " + cli.bold("files") + "    - List current directory items with types");
    print("  " + cli.bold("run") + "      - Execute a shell command through Blizzard sys");
    print("");
    cli.info("Try running: blizzard examples/cli_app.blizz sysinfo");
}
