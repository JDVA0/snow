# Snow File Processor Demo — Modular file parsing and reporting in Snow.
#
# Usage:
#   snowman examples/file_processor.snow

using fs
using cli

# Dedicated parsing function: parses a line and returns a structured record or nil
fn procesar_linea(linea):
    partes = split(trim(linea), ",")
    if len(partes) != 2:
        return nil

    return {
        servidor: trim(partes[0]),
        estado: trim(partes[1])
    }

archivo_origen = "registro.txt"

# Create a sample file with both valid and invalid lines if it doesn't exist
if not fs.exists(archivo_origen):
    fs.write(archivo_origen, "servidor_1,activo\nservidor_2,inactivo\nlinea_corrupta_ignorada\nservidor_3,activo\n")

contenido = fs.read(archivo_origen)
lineas = split(contenido, "\n")

cli.box("PROCESADOR DE ARCHIVOS", f"Archivo: {archivo_origen} | Total líneas leídas: {len(lineas)}")

filas = []
activos = 0

for l in lineas:
    item = procesar_linea(l)
    if item != nil:
        if item.estado == "activo":
            activos += 1
        filas = append(filas, [item.servidor, item.estado])

cli.table(["SERVIDOR", "ESTADO"], filas)
cli.success(f"Servidores activos: {activos} de {len(filas)} válidos procesados.")
