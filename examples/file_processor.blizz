# Blizzard File Processor Demo — Modular file parsing and reporting in Blizzard.
#
# Usage:
#   blizzard examples/file_processor.blizz

import fs;
import cli;

# Dedicated parsing function: parses a line and returns a structured record or nil
fn procesar_linea(linea) {
    let partes = split(trim(linea), ",");
    if (len(partes) != 2) {
        return nil;
    }

    return {servidor: trim(partes[0]), estado: trim(partes[1])};
}

let archivo_origen = "registro.txt";

# Create a sample file with both valid and invalid lines if it doesn't exist
if (not fs.exists(archivo_origen)) {
    fs.write(archivo_origen, """servidor_1,activo
servidor_2,inactivo
linea_corrupta_ignorada
servidor_3,activo
""");
}

let contenido = fs.read(archivo_origen);
let lineas = split(contenido, """
""");

cli.box("PROCESADOR DE ARCHIVOS", f"Archivo: {archivo_origen} | Total líneas leídas: {len(lineas)}");

let filas = [];
let activos = 0;

for l in lineas {
    let item = procesar_linea(l);
    if (item != nil) {
        if (item.estado == "activo") {
            activos += 1;
        }
        filas = append(filas, [item.servidor, item.estado]);
    }
}

cli.table(["SERVIDOR", "ESTADO"], filas);
cli.success(f"Servidores activos: {activos} de {len(filas)} válidos procesados.");
