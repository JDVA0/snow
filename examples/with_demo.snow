# Demo de `with` statement (gestión automática de recursos)
#
# Ejecutar: snowman examples/with_demo.snow

using cli

cli.box("DEMO: with statement", "Gestión automática de recursos (auto-close)")

# ======================================================
# 1. Helper que crea un "recurso" (dict con close())
# ======================================================
make_resource = fn(name, data):
    state = {"opened": true, "closed": false, "errors": []}

    close_fn = fn():
        if state.closed:
            state.errors = append(state.errors, "double close")
        else:
            state.closed = true
            state.opened = false
            cli.ok("   ✅ Recurso '" + name + "' cerrado automáticamente.")

    return {
        "name": name,
        "data": data,
        "state": state,
        "read": fn(): return data,
        "close": close_fn,
    }

# ======================================================
# 2. with simple - asegura que close() se llame
# ======================================================
cli.info("1. Bloque 'with' básico (auto-close al salir):")

final = nil
with make_resource("database", "tabla=users, rows=100") as db:
    cli.ok("   • Dentro del with: db.opened = true")
    print("     Leyendo datos: " + db.read())
    final = db.state

print()
print("   Después del with:")
print("     opened = " + str(final.opened))
print("     closed = " + str(final.closed))
print()

# ======================================================
# 3. with sin 'as' (no necesitamos el nombre)
# ======================================================
cli.info("2. with sin asignación 'as':")
# Útil si el efecto de close() basta
with make_resource("temp_file", "tmp.log"):
    cli.ok("   • Bloque ejecutado, sin binding 'as'")

print()

# ======================================================
# 4. El atributo close() es OPCIONAL - si no existe, no-op
# ======================================================
cli.info("3. Recurso SIN método close() - no hay error, sin-op:")
plain_dict = {"msg": "soy un dict normal, no tengo close"}
with plain_dict:
    cli.ok("   • Bloque ejecutado. No hay close(), así que nada más pasa.")

print()
cli.success("with statement: recursos cerrados automáticamente al salir del bloque.")
